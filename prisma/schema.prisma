// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

model Education {
  id        Int      @id @default(autoincrement())
  name      String   @default("NULL")
  users     User[]
  courses   Course[]
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model User {
  id          Int       @id @default(autoincrement())
  userRole    Role      @default(STUDENT)
  education   Education @relation(fields: [educationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  educationId Int
  email       String    @unique
  password    String    @default("NULL")
  firstName   String    @default("NULL")
  lastName    String    @default("NULL")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
}

model Admin {
  id        Int      @id @default(autoincrement())
  userRole  Role     @default(ADMIN)
  email     String   @unique
  password  String   @default("NULL")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Course_lib {
  id          Int      @id @default(autoincrement())
  // modules     Module_lib[]
  title       String
  description String   @db.LongText
  content     String   @db.LongText
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
}

model Module_lib {
  id          Int      @id @default(autoincrement())
  // courseLib   Course_lib     @relation(fields: [courseLibId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  // courseLibId Int
  // exercises   Exercise_lib[]
  title       String
  description String   @db.LongText
  content     String   @db.LongText
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
}

model Exercise_lib {
  id          Int      @id @default(autoincrement())
  // module      Module_lib? @relation(fields: [moduleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  moduleId    Int?
  title       String
  description String   @db.LongText
  content     String   @db.LongText
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
}

model Course {
  id          Int        @id @default(autoincrement())
  education   Education? @relation(fields: [educationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  educationId Int
  modules     Module[]
  title       String
  slug        String
  points      String
  icon        String
  color       String
  content     String     @db.LongText
  published   Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @default(now()) @updatedAt
}

model Module {
  id        Int        @id @default(autoincrement())
  course    Course?    @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  courseId  Int?
  exercises Exercise[]
  title     String
  startDate String
  endDate   String
  content   String     @db.LongText
  //description String     @db.LongText
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now()) @updatedAt
}

model Exercise {
  id        Int      @id @default(autoincrement())
  module    Module?  @relation(fields: [moduleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  moduleId  Int?
  title     String
  slug      String
  //description String   @db.LongText
  content   String   @db.LongText
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}
