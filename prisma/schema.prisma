// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Education {
  id        String   @id @default(uuid())
  name      String   @default("NULL")
  users     User[]
  //courses
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id          String    @id @default(uuid())
  userRole    String    @default("NULL")
  education   Education @relation(fields: [educationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  educationId String
  email       String    @unique
  password    String    @default("NULL")
  firstName   String    @default("NULL")
  lastName    String    @default("NULL")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Admin {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String   @default("NULL")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Course_lib {
  id          String       @id @default(uuid())
  modules     Module_lib[]
  title       String
  description String
  content     String
}

model Module_lib {
  id          String         @id @default(uuid())
  course      Course_lib     @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  courseId    String
  exercises   Exercise_lib[]
  title       String
  description String
  content     String
}

model Exercise_lib {
  id          String      @id @default(uuid())
  module      Module_lib? @relation(fields: [moduleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  moduleId    String
  title       String
  description String
  content     String
}

model Course {
  id          String   @id @default(uuid())
  modules     Module[]
  title       String
  description String
  content     String
}

model Module {
  id          String     @id @default(uuid())
  course      Course     @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  courseId    String
  exercises   Exercise[]
  title       String
  description String
  content     String
}

model Exercise {
  id          String  @id @default(uuid())
  module      Module? @relation(fields: [moduleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  moduleId    String
  title       String
  description String
  content     String
}
