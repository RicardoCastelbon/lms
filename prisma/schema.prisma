// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Education {
  id        Int      @id @default(autoincrement())
  name      String   @default("NULL")
  users     User[]
  //courses
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id          Int       @id @default(autoincrement())
  userRole    String    @default("NULL")
  education   Education @relation(fields: [educationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  educationId Int //@unique
  //username  String   @unique
  email       String    @unique
  password    String    @default("NULL")
  firstName   String    @default("NULL")
  lastName    String    @default("NULL")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Admin {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String   @default("NULL")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Course_lib {
  id          Int          @id @default(autoincrement())
  modules     Module_lib[]
  title       String
  description String
  content     String
}

model Module_lib {
  id          Int            @id @default(autoincrement())
  course      Course_lib     @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  courseId    Int            @unique
  exercises   Exercise_lib[]
  title       String
  description String
  content     String
}

model Exercise_lib {
  id          Int         @id @default(autoincrement())
  module      Module_lib? @relation(fields: [moduleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  moduleId    Int         @unique
  title       String
  description String
  content     String
}

model Course {
  id          Int      @id @default(autoincrement())
  modules     Module[]
  title       String
  description String
  content     String
}

model Module {
  id          Int        @id @default(autoincrement())
  course      Course     @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  courseId    Int        @unique
  exercises   Exercise[]
  title       String
  description String
  content     String
}

model Exercise {
  id          Int     @id @default(autoincrement())
  module      Module? @relation(fields: [moduleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  moduleId    Int     @unique
  title       String
  description String
  content     String
}
